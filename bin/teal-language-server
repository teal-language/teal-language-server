#!/usr/bin/env lua

-- The below patch was generated by AI. It appeared that teal-language-server was broken for Lua 5.1,
-- but no one has put in an issue yet. With this fix, the integration tests are all now working.

-- Lua 5.1 cannot yield a coroutine across a C-function boundary (pcall/xpcall).
-- lusc_luv uses util.try() → xpcall internally around every yield point, so the
-- server deadlocks immediately on Lua 5.1.  Lua 5.2+/LuaJIT have yieldable
-- xpcall natively, so no patch is needed there.
--
-- Two patches are applied to compat53 BEFORE lusc's util.lua is first required
-- and captures xpcall / coroutine as local upvalues:
--
--   1. xpcall → sub-coroutine shim that forwards yields transparently.
--   2. coroutine.running → returns the ancestor *task* coroutine rather than
--      a shim sub-coroutine, so lusc's _tasks_by_coro lookup still works.
if _VERSION == "Lua 5.1" and type(jit) ~= "table" then
    local ok, compat53 = pcall(require, "compat53.module")
    if ok then
        local orig_xpcall    = xpcall
        local co_create      = coroutine.create
        local co_resume      = coroutine.resume
        local co_status      = coroutine.status
        local co_yield       = coroutine.yield
        local co_running_raw = coroutine.running  -- stock Lua 5.1 (nil in main thread)
        local tbl_remove     = table.remove
        local sel            = select
        local unp            = unpack

        -- Maps shim sub-coroutine → ancestor task coroutine.
        local subcoro_to_task = {}

        -- Patch 1: coroutine.running
        -- lusc uses _tl_compat.coroutine.running() to identify which task is active
        -- (via _tasks_by_coro[coroutine.running()]).  When called from inside a shim
        -- sub-coroutine, return the original task coroutine instead.
        local orig_compat53_running = compat53.coroutine.running
        compat53.coroutine.running = function()
            local co = co_running_raw()
            if co then
                local task_co = subcoro_to_task[co]
                if task_co then
                    return task_co, false
                end
                return co, false
            end
            return orig_compat53_running()  -- main thread path
        end

        -- Patch 2: xpcall
        -- Run the protected function inside a shim sub-coroutine.  Any coroutine.yield
        -- calls inside f are forwarded to the parent task coroutine so lusc can
        -- schedule/resume the task normally.
        compat53.xpcall = function(f, msgh, ...)
            local args = {...}
            local n = sel('#', ...)

            local current_co = co_running_raw()
            if current_co == nil then
                -- Main thread: yielding is impossible regardless; use standard path.
                return orig_xpcall(function() return f(unp(args, 1, n)) end, msgh)
            end

            -- Resolve the ancestor task coroutine (handles nested coxpcall calls).
            local task_co = subcoro_to_task[current_co] or current_co

            local subcoro = co_create(function() return f(unp(args, 1, n)) end)
            subcoro_to_task[subcoro] = task_co

            local resume_args = {}
            local resume_n    = 0
            while true do
                local ret  = {co_resume(subcoro, unp(resume_args, 1, resume_n))}
                local ok2  = tbl_remove(ret, 1)
                local nret = #ret

                if not ok2 then
                    subcoro_to_task[subcoro] = nil
                    return false, msgh(ret[1])
                end

                if co_status(subcoro) == "dead" then
                    subcoro_to_task[subcoro] = nil
                    return true, unp(ret, 1, nret)
                end

                -- Sub-coroutine yielded; forward to the parent task coroutine and
                -- pass whatever the parent is resumed with back into the sub-coroutine.
                resume_args = {co_yield(unp(ret, 1, nret))}
                resume_n    = #resume_args
            end
        end
    end
end

require('teal_language_server.main')
